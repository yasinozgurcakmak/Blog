@model List<DtoLayer.Dtos.HomeDtos.BlogCardDto>
@{
    ViewData["Title"] = "Kaydedilenler";
}

<div class="container">
    <section class="feed">
        <h1 class="feed__title">Kaydedilenler</h1>

        @if (Model.Count == 0)
        {
            <div class="empty-state">
                <h2>Henüz kaydedilmiş makale yok</h2>
                <p>Daha sonra okumak istediğin bir yazının üst kısmındaki kaydet simgesine dokun; yazı burada listelenir.</p>
                <a href="/" class="btn btn--ghost">Yazılara göz at</a>
            </div>
        }
        else
        {
            <partial name="~/Views/Home/_BlogCards.cshtml" model="Model" />
        }
    </section>
</div>
