@model DtoLayer.Dtos.UserDtos.ForgotPasswordDto
@{
    ViewData["Title"] = "Şifremi Unuttum";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    var sentTo = ViewData["SentTo"] as string;
    var generalErrors = ViewData.ModelState[string.Empty]?.Errors;
}

<a href="/giris-yap" class="btn btn--ghost auth-page__back">
    &larr; Girişe Dön
</a>

<div class="auth-card">
    <div class="auth-card__header">
        <div class="icon">🔑</div>
        <h2>Şifreni sıfırla</h2>
        <p>
            @if (sentTo is null)
            {
                @:Hesabına kayıtlı e-posta adresini gir, sana şifre sıfırlama linki gönderelim.
            }
            else
            {
                @:Şifre sıfırlama linki e-posta adresine gönderildi.
            }
        </p>
    </div>

    @if (sentTo is null)
    {
        <form class="auth-form" method="post" action="/sifremi-unuttum">
            @Html.AntiForgeryToken()

            @if (generalErrors is { Count: > 0 })
            {
                <div class="alert alert--error">
                    <i>⚠</i>
                    <div>
                        <strong>Gönderilemedi</strong>
                        @foreach (var error in generalErrors)
                        {
                            <span>@error.ErrorMessage</span>
                        }
                    </div>
                </div>
            }

            <div class="form-group">
                <label asp-for="Email">E-posta Adresi</label>
                <div class="input-wrapper">
                    <input asp-for="Email" type="email" id="forgot-email" placeholder="ornek@mail.com" autocomplete="email" required autofocus>
                </div>
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
            <button type="submit" class="btn btn--primary btn--full">Sıfırlama Linki Gönder</button>
        </form>

        <div class="auth-note">
            <i>🛡️</i>
            <span>Şifre sıfırlama linkini kimseyle paylaşma. Senden hiçbir zaman e-posta ile şifre istemeyiz.</span>
        </div>
    }
    else
    {
        <div class="auth-form">
            <div class="alert alert--success">
                <i>✓</i>
                <div>
                    <strong>E-postanı kontrol et</strong>
                    <span><code class="auth-code">@sentTo</code> adresi kayıtlı bir hesaba aitse şifre sıfırlama linki gönderildi. Link 1 saat geçerlidir.</span>
                </div>
            </div>
        </div>

        <div class="auth-inbox">
            <div class="auth-inbox__title">Gelen kutunu hızlıca aç</div>
            <div class="auth-inbox__links">
                <a href="https://mail.google.com" target="_blank" rel="noopener noreferrer" class="btn btn--ghost">Gmail'i Aç</a>
                <a href="https://outlook.live.com" target="_blank" rel="noopener noreferrer" class="btn btn--ghost">Outlook'u Aç</a>
            </div>
        </div>

        <form class="auth-resend" method="post" action="/sifremi-unuttum">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Email" value="@sentTo" />
            <span>E-posta gelmedi mi? Spam klasörünü de kontrol et.</span>
            <button type="submit" id="resend-btn" data-cooldown="@Blog.Controllers.PasswordController.ResendCooldownSeconds" disabled>Tekrar gönder</button>
        </form>
    }

    <div class="auth-card__footer auth-card__footer--bordered">
        <a href="/giris-yap">&larr; Giriş sayfasına dön</a>
    </div>
</div>
