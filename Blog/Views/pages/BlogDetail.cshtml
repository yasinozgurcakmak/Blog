@model DtoLayer.Dtos.HomeDtos.BlogDetailDto
@using System.Globalization
@{
    var tr = CultureInfo.GetCultureInfo("tr-TR");
    var viewCount = Model.ViewCount >= 1000
        ? (Model.ViewCount / 1000.0).ToString("0.#", CultureInfo.InvariantCulture) + "k"
        : Model.ViewCount.ToString();
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.MetaTitle) ? Model.Title : Model.MetaTitle;

   
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var pageUrl = $"{baseUrl}/makale/{Model.Slug}";
    var description = string.IsNullOrWhiteSpace(Model.MetaDescription) ? Model.Summary : Model.MetaDescription;
    var imageUrl = string.IsNullOrWhiteSpace(Model.Thumbnail) ? null : Model.Thumbnail.StartsWith("http") ? Model.Thumbnail : baseUrl + "/" + Model.Thumbnail.TrimStart('~', '/');

    var encodedUrl = Uri.EscapeDataString(pageUrl);
    var encodedTitle = Uri.EscapeDataString(Model.Title);

    var authorAvatar = string.IsNullOrWhiteSpace(Model.AuthorImageUrl)
        ? "https://ui-avatars.com/api/?name=" + Uri.EscapeDataString(Model.AuthorName.Trim()) + "&background=random&color=fff&size=160"
        : Model.AuthorImageUrl;

    var authorLinks = new[]
    {
        (Url: Model.AuthorGithubUrl, Title: "GitHub", Short: "GH"),
        (Url: Model.AuthorInstagramUrl, Title: "Instagram", Short: ""),
        (Url: Model.AuthorXUrl, Title: "X (Twitter)", Short: "𝕏"),
        (Url: Model.AuthorFacebookUrl, Title: "Facebook", Short: "ⓕ"),
        (Url: Model.AuthorWebsiteUrl, Title: "Web Sitesi", Short: "🌐︎")
    }.Where(l => !string.IsNullOrWhiteSpace(l.Url)).ToList();
}

@section Head {
    <link rel="canonical" href="@pageUrl">
    <meta name="description" content="@description">
    <meta property="og:type" content="article">
    <meta property="og:url" content="@pageUrl">
    <meta property="og:title" content="@ViewData["Title"]">
    <meta property="og:description" content="@description">
    @if (imageUrl is not null)
    {
        <meta property="og:image" content="@imageUrl">
    }
    <meta name="twitter:card" content="@(imageUrl is null ? "summary" : "summary_large_image")">
}

<div class="container container--article">
    <article class="article-view">

        <header class="article-header">
            <div class="tags">
                <a href="/?categoryId=@Model.CategoryId" class="tag tag--purple">@Model.CategoryName</a>
            </div>

            <h1>@Model.Title</h1>

            <div class="article-meta">
                <div class="author">
                    @if (!string.IsNullOrWhiteSpace(Model.AuthorImageUrl))
                    {
                        <img src="@Model.AuthorImageUrl" alt="@Model.AuthorName">
                    }
                    <div class="author__details">
                        <div class="author__name">
                            <strong>@Model.AuthorName</strong>
                            <em>Yazar</em>
                        </div>
                        <div class="author__date">
                            <span>@Model.PublishedAt.ToString("dd MMM yyyy", tr)</span>
                            <i>•</i>
                            <span>@Model.ReadingTime dk okuma</span>
                        </div>
                    </div>
                </div>

                <div class="share-actions">
                    <span class="btn-action" title="Görüntülenme"><svg height="10px" width="10px" version="1.1" id="Capa_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 277.58 277.58" xml:space="preserve" fill="#fff" stroke="#fff"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <g> <path style="fill:#fff;" d="M138.46,164.287c-38.628,0-69.925-37.519-69.925-83.767C68.535,34.277,99.832,0,138.46,0 c38.634,0,69.957,34.277,69.957,80.52C208.417,126.768,177.093,164.287,138.46,164.287z M29.689,277.528 c0,0-14.832,0.979-21.365-8.023c-3.53-4.863-1.071-14.718,1.343-20.217l5.912-13.473c0,0,16.35-36.567,34.962-57.757 c11.433-12.994,25.031-10.035,33.826-5.809c5.417,2.6,11.542,10.176,16.018,14.191c6.168,5.532,17.057,11.819,34.859,12.173h10.922 c17.791-0.354,28.68-6.641,34.843-12.173c4.471-4.014,10.427-11.825,15.795-14.511c8.072-4.041,20.358-6.527,31.492,6.13 c18.618,21.191,33.363,58.421,33.363,58.421l6.059,13.212c2.507,5.461,5.075,15.267,1.643,20.195 c-6.124,8.811-19.874,7.642-19.874,7.642S29.689,277.528,29.689,277.528z"></path> </g> </g></svg> @viewCount</span>
                    <button class="btn-action" title="Bookmark"><svg width="25px" height="25px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path fill-rule="evenodd" clip-rule="evenodd" d="M6.75 6L7.5 5.25H16.5L17.25 6V19.3162L12 16.2051L6.75 19.3162V6ZM8.25 6.75V16.6838L12 14.4615L15.75 16.6838V6.75H8.25Z" fill="#ffffff"></path> </g></svg></button>
                </div>
            </div>
        </header>

        <div class="article-body">
            @Html.Raw(Model.Content)
        </div>

        <div class="article-footer">
            <div class="reactions">
                <button class="btn-action">👏 482 Alkış</button>
            </div>
            <div class="social-share">
                <span>Share this:</span>
                <a href="https://www.facebook.com/sharer/sharer.php?u=@encodedUrl" target="_blank" rel="noopener noreferrer" class="btn btn--ghost">Facebook</a>
                <a href="https://www.linkedin.com/sharing/share-offsite/?url=@encodedUrl" target="_blank" rel="noopener noreferrer" class="btn btn--ghost">Linkedin</a>
                <a href="https://x.com/intent/post?url=@encodedUrl&text=@encodedTitle" target="_blank" rel="noopener noreferrer" class="btn btn--ghost">X</a>
            </div>
        </div>

        <section class="comments-section">
            <div class="comments-section__header">
                <h3>Yorumlar <span>14</span></h3>
            </div>

            <div class="locked-banner">
                <div class="info">
                    <svg width="20px" height="20px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M12 14.5V16.5M7 10.0288C7.47142 10 8.05259 10 8.8 10H15.2C15.9474 10 16.5286 10 17 10.0288M7 10.0288C6.41168 10.0647 5.99429 10.1455 5.63803 10.327C5.07354 10.6146 4.6146 11.0735 4.32698 11.638C4 12.2798 4 13.1198 4 14.8V16.2C4 17.8802 4 18.7202 4.32698 19.362C4.6146 19.9265 5.07354 20.3854 5.63803 20.673C6.27976 21 7.11984 21 8.8 21H15.2C16.8802 21 17.7202 21 18.362 20.673C18.9265 20.3854 19.3854 19.9265 19.673 19.362C20 18.7202 20 17.8802 20 16.2V14.8C20 13.1198 20 12.2798 19.673 11.638C19.3854 11.0735 18.9265 10.6146 18.362 10.327C18.0057 10.1455 17.5883 10.0647 17 10.0288M7 10.0288V8C7 5.23858 9.23858 3 12 3C14.7614 3 17 5.23858 17 8V10.0288" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg>
                    <div>
                        <h4>Yorum yapabilmek için giriş yapmanız gerekmektedir.</h4>
                    </div>
                </div>
                <div class="actions">
                    <button class="btn btn--primary">Giriş Yap</button>
                    <button class="btn btn--primary">Üye Ol</button>
                </div>
            </div>

            <div class="comments-list">
                <div class="comment">
                    <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuDq0wGHpG2nstD10vc614CNFGY-vsAw7F5Fv4840N-pmt2BOSFkzW5-kc8N3XV2QNlL8XPnbnwJklrOoLI8O129b_4mAQLTZ6ywvSM_h2E339x1pMAfE22fw3MdfIX3kkpJWQENircy9Cv8jjHJ1IFw1zsYJmaML0T9h-t7VwZ3-rUP-gw_nJkhEUyn5-DjkgBdo8Q5Q2nMn-I6PGU8wTJVNStA-RlwD6yEkT6xGdA08z-tImR3VV5A" alt="Sarah">
                    <div class="comment__body">
                        <div class="head">
                            <h5>Sarah Jenkins <span>Senior SRE â€¢ 2h ago</span></h5>
                            <button>...</button>
                        </div>
                        <p>Totally agree regarding edge runtimes. We recently migrated our catalog rendering to regional workers and observed a 65% reduction in P99 TTFB globally.</p>
                        <div class="foot">
                            <button> ❤️ 24</button>
                            <button>Cevapla</button>
                        </div>
                    </div>
                </div>

                <div class="comment">
                    <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuCOQKtRynWBWg3gRxkgi1YKveHxAzqp0x6ZF5exuo_pCp9RydulJC74dCTX4Ubd-Pko7829_kaTe_oPmfbwWX4s7nHsOb7odKkxYBOYxt5xujhuruvPhxtTi4fTqWR1TzlfQwGlNPXk5QAbgGWZwXw3aEoyPNeiAYPLKyw6uGB8YjZl6e34_4h-gPDVeYxpAAIFOKzlJXZ_62bOxiGAOfvcKU_UUY8oyYQo6ZqPiRqkpDrY1eyrCAEi" alt="Marcus">
                    <div class="comment__body">
                        <div class="head">
                            <h5>Marcus Vance <span>Design Systems Lead â€¢ 5h ago</span></h5>
                            <button>...</button>
                        </div>
                        <p>How do you handle token sync between Figma variables and the automated build pipelines when relying on edge hydration?</p>
                        <div class="foot">
                            <button>❤️ 8</button>
                            <button>Cevapla</button>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </article>

    <aside class="sidebar sidebar--sticky">
        <div class="widget widget--author">
            <div class="widget-header">
                <span>Yazar Hakkında</span>
                <i></i>
            </div>
            <div class="author-info">
                <img src="@authorAvatar" alt="@Model.AuthorName">
                <div>
                    <h4>@Model.AuthorName</h4>
                    <p>@(string.IsNullOrWhiteSpace(Model.AuthorHeadline) ? "Yazar" : Model.AuthorHeadline)</p>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.AuthorBio))
            {
                <p class="bio">@Model.AuthorBio</p>
            }
            @if (authorLinks.Count > 0)
            {
                    
                <div class="author-actions">
                    <p>İletişim ve Sosyal Medya</p>
                    <div class="socials">
                        @foreach (var link in authorLinks)
                        {
                            <a href="@link.Url" target="_blank" rel="noopener noreferrer nofollow" title="@link.Title" aria-label="@link.Title">@link.Title <svg fill="#94a3b8" width="15px" height="15px" viewBox="-5.5 0 32 32" version="1.1" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <title>external</title> <path d="M15.656 8.5l-10.438 10.5 2.188 2.219 10.469-10.469 1.938 1.906c0.531 0.531 1 0.375 1-0.438v-5.656c0-0.5-0.438-0.969-0.969-0.969h-5.656c-0.813 0-1 0.469-0.469 1zM16.813 23.031v-7.094h2.375v7.906c0 1.406-1.156 2.563-2.563 2.563h-14.063c-1.406 0-2.563-1.156-2.563-2.563v-14.094c0-1.406 1.156-2.563 2.563-2.531h8.656v2.375h-7.844c-0.5 0-0.969 0.469-0.969 0.969v12.469c0 0.5 0.469 0.969 0.969 0.969h12.469c0.5 0 0.969-0.469 0.969-0.969z"></path> </g></svg></a>
                        }
                    </div>
                </div>
            }
        </div>


    </aside>
</div>
