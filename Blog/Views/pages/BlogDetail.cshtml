@model DtoLayer.Dtos.HomeDtos.BlogDetailDto
@using System.Globalization
@using DtoLayer.Dtos.CommentDtos
@{
    var tr = CultureInfo.GetCultureInfo("tr-TR");
    var viewCount = Model.ViewCount >= 1000
        ? (Model.ViewCount / 1000.0).ToString("0.#", CultureInfo.InvariantCulture) + "k"
        : Model.ViewCount.ToString();
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.MetaTitle) ? Model.Title : Model.MetaTitle;

   
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var pageUrl = $"{baseUrl}{Url.Content("~/makale/")}{Model.Slug}";
    var description = string.IsNullOrWhiteSpace(Model.MetaDescription) ? Model.Summary : Model.MetaDescription;
    var imageUrl = string.IsNullOrWhiteSpace(Model.Thumbnail) ? null : Model.Thumbnail.StartsWith("http") ? Model.Thumbnail : baseUrl + Url.Content("~/") + Model.Thumbnail.TrimStart('~', '/');

    var encodedUrl = Uri.EscapeDataString(pageUrl);
    var encodedTitle = Uri.EscapeDataString(Model.Title);

    var authorAvatar = string.IsNullOrWhiteSpace(Model.AuthorImageUrl)
        ? "https://ui-avatars.com/api/?name=" + Uri.EscapeDataString(Model.AuthorName.Trim()) + "&background=random&color=fff&size=160"
        : Model.AuthorImageUrl;

    var authorLinks = new[]
    {
        (Url: Model.AuthorGithubUrl, Title: "GitHub", Short: "GH"),
        (Url: Model.AuthorInstagramUrl, Title: "Instagram", Short: ""),
        (Url: Model.AuthorXUrl, Title: "X (Twitter)", Short: "𝕏"),
        (Url: Model.AuthorFacebookUrl, Title: "Facebook", Short: "ⓕ"),
        (Url: Model.AuthorWebsiteUrl, Title: "Web Sitesi", Short: "🌐︎")
    }.Where(l => !string.IsNullOrWhiteSpace(l.Url)).ToList();
}

@section Head {
    <link rel="canonical" href="@pageUrl">
    <meta name="description" content="@description">
    <meta property="og:type" content="article">
    <meta property="og:url" content="@pageUrl">
    <meta property="og:title" content="@ViewData["Title"]">
    <meta property="og:description" content="@description">
    @if (imageUrl is not null)
    {
        <meta property="og:image" content="@imageUrl">
    }
    <meta name="twitter:card" content="@(imageUrl is null ? "summary" : "summary_large_image")">
}

@section Scripts {
    <script src="~/assets/js/blog-detail.js" asp-append-version="true"></script>
}

<div class="container container--article">
    <article class="article-view">

        <header class="article-header">
            <div class="tags">
                <a href="~/?categoryId=@Model.CategoryId" class="tag tag--purple">@Model.CategoryName</a>
            </div>

            <h1>@Model.Title</h1>

            <div class="article-meta">
                <div class="author">
                    @if (!string.IsNullOrWhiteSpace(Model.AuthorImageUrl))
                    {
                        <img src="@Model.AuthorImageUrl" alt="@Model.AuthorName">
                    }
                    <div class="author__details">
                        <div class="author__name">
                            <strong>@Model.AuthorName</strong>
                            <em>Yazar</em>
                        </div>
                        <div class="author__date">
                            <span>@Model.PublishedAt.ToString("dd MMM yyyy", tr)</span>
                            <i>•</i>
                            <span>@Model.ReadingTime dk okuma</span>
                        </div>
                    </div>
                </div>

                <div class="share-actions">
                    <span class="btn-action" title="Görüntülenme"><svg height="10px" width="10px" version="1.1" id="Capa_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 277.58 277.58" xml:space="preserve" fill="#fff" stroke="#fff"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <g> <path style="fill:#fff;" d="M138.46,164.287c-38.628,0-69.925-37.519-69.925-83.767C68.535,34.277,99.832,0,138.46,0 c38.634,0,69.957,34.277,69.957,80.52C208.417,126.768,177.093,164.287,138.46,164.287z M29.689,277.528 c0,0-14.832,0.979-21.365-8.023c-3.53-4.863-1.071-14.718,1.343-20.217l5.912-13.473c0,0,16.35-36.567,34.962-57.757 c11.433-12.994,25.031-10.035,33.826-5.809c5.417,2.6,11.542,10.176,16.018,14.191c6.168,5.532,17.057,11.819,34.859,12.173h10.922 c17.791-0.354,28.68-6.641,34.843-12.173c4.471-4.014,10.427-11.825,15.795-14.511c8.072-4.041,20.358-6.527,31.492,6.13 c18.618,21.191,33.363,58.421,33.363,58.421l6.059,13.212c2.507,5.461,5.075,15.267,1.643,20.195 c-6.124,8.811-19.874,7.642-19.874,7.642S29.689,277.528,29.689,277.528z"></path> </g> </g></svg> @viewCount</span>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <button type="button" id="bookmark-btn" class="btn-action btn-bookmark@(Model.IsBookmarked ? " is-active" : "")" data-url="@Url.Content("~/makale/" + Model.Id + "/kaydet")"
                                aria-pressed="@(Model.IsBookmarked ? "true" : "false")" title="@(Model.IsBookmarked ? "Kayıtlardan çıkar" : "Kaydet")" aria-label="@(Model.IsBookmarked ? "Kayıtlardan çıkar" : "Kaydet")">
                            <svg width="25px" height="25px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path class="btn-bookmark__fill" d="M6.75 6L7.5 5.25H16.5L17.25 6V19.3162L12 16.2051L6.75 19.3162V6Z" fill="currentColor"></path><path fill-rule="evenodd" clip-rule="evenodd" d="M6.75 6L7.5 5.25H16.5L17.25 6V19.3162L12 16.2051L6.75 19.3162V6ZM8.25 6.75V16.6838L12 14.4615L15.75 16.6838V6.75H8.25Z" fill="currentColor"></path></svg>
                        </button>
                    }
                    else
                    {
                        <a href="~/giris-yap?geldigiSayfa=@Uri.EscapeDataString("/makale/" + Model.Slug)" class="btn-action btn-bookmark" title="Kaydetmek için giriş yapın" aria-label="Kaydetmek için giriş yapın">
                            <svg width="25px" height="25px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M6.75 6L7.5 5.25H16.5L17.25 6V19.3162L12 16.2051L6.75 19.3162V6ZM8.25 6.75V16.6838L12 14.4615L15.75 16.6838V6.75H8.25Z" fill="currentColor"></path></svg>
                        </a>
                    }
                </div>
            </div>
        </header>

        <div class="article-body">
            @Html.Raw(Model.Content)
        </div>

        <div class="article-footer">
            <div class="reactions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @Html.AntiForgeryToken()
                    <button type="button" id="clap-btn" class="btn-action@(Model.IsLiked ? " is-active" : "")"
                            data-url="@Url.Content("~/makale/" + Model.Id + "/alkis")" aria-pressed="@(Model.IsLiked ? "true" : "false")"
                            title="@(Model.IsLiked ? "Alkışı geri al" : "Alkışla")">
                        👏 <span id="clap-count">@Model.LikeCount</span> Alkış
                    </button>
                }
                else
                {
                    <a href="~/giris-yap?geldigiSayfa=@Uri.EscapeDataString("/makale/" + Model.Slug)" class="btn-action" title="Alkışlamak için giriş yapın">👏 @Model.LikeCount Alkış</a>
                }
            </div>
            <div class="social-share">
                <span>Share this:</span>
                <a href="https://www.facebook.com/sharer/sharer.php?u=@encodedUrl" target="_blank" rel="noopener noreferrer" class="btn btn--ghost">Facebook</a>
                <a href="https://www.linkedin.com/sharing/share-offsite/?url=@encodedUrl" target="_blank" rel="noopener noreferrer" class="btn btn--ghost">Linkedin</a>
                <a href="https://x.com/intent/post?url=@encodedUrl&text=@encodedTitle" target="_blank" rel="noopener noreferrer" class="btn btn--ghost">X</a>
            </div>
        </div>

        @{
            
            const int MaxIndentDepth = 3;
            var isAuthenticated = User.Identity?.IsAuthenticated == true;
            var loginUrl = Url.Content("~/giris-yap") + "?geldigiSayfa=" + Uri.EscapeDataString("/makale/" + Model.Slug);

            string CommentAvatar(CommentDto comment) => string.IsNullOrWhiteSpace(comment.AuthorImageUrl)
                ? "https://ui-avatars.com/api/?name=" + Uri.EscapeDataString(comment.AuthorName.Trim()) + "&background=random&color=fff&size=80"
                : comment.AuthorImageUrl;

            async Task RenderThread(List<CommentDto> comments, int depth)
            {
                foreach (var comment in comments)
                {
                    await RenderComment(comment, depth);
                    if (depth >= MaxIndentDepth) await RenderThread(comment.Replies, depth + 1);
                }
            }

            async Task RenderComment(CommentDto comment, int depth)
            {
                <div class="comment@(comment.IsDeleted ? " comment--deleted" : "")" id="comment-@comment.Id">
                    @if (!comment.IsDeleted)
                    {
                        <img src="@CommentAvatar(comment)" alt="">
                    }
                    <div class="comment__body">
                        @if (comment.IsDeleted)
                        {
                            <p class="comment__text">Bu yorum silindi.</p>
                        }
                        else
                        {
                            <div class="head">
                                <h5>@comment.AuthorName <span>@(string.IsNullOrWhiteSpace(comment.AuthorHeadline) ? "" : comment.AuthorHeadline + " • ")@comment.CreatedDate.ToString("dd MMM yyyy HH:mm", tr)</span></h5>
                                @if (comment.IsOwner)
                                {
                                    <div class="comment-menu">
                                        <button type="button" class="comment-menu__toggle" aria-expanded="false" aria-label="Yorum seçenekleri">...</button>
                                        <form class="comment-menu__list" method="post" action="~/makale/@Model.Slug/yorum/@comment.Id/sil" hidden>
                                            @Html.AntiForgeryToken()
                                            <button type="submit">Yorumu sil</button>
                                        </form>
                                    </div>
                                }
                            </div>
                            @if (depth > MaxIndentDepth && comment.ReplyToName is not null)
                            {
                                <p class="comment__reply-to">Yanıtlanan: @comment.ReplyToName</p>
                            }
                            <p class="comment__text">@comment.Content</p>
                            <div class="foot">
                                @if (isAuthenticated)
                                {
                                    <button type="button" class="comment-like@(comment.IsLiked ? " is-active" : "")" data-url="@Url.Content("~/yorum/" + comment.Id + "/begen")"
                                            aria-pressed="@(comment.IsLiked ? "true" : "false")" aria-label="Beğen">❤️ <span>@comment.LikeCount</span></button>
                                    <button type="button" class="comment-reply" data-comment-id="@comment.Id" aria-expanded="false">Cevapla</button>
                                }
                                else
                                {
                                    <a href="@loginUrl" title="Beğenmek için giriş yapın">❤️ @comment.LikeCount</a>
                                    <a href="@loginUrl">Cevapla</a>
                                }
                            </div>
                        }
                        @if (depth < MaxIndentDepth && comment.Replies.Count > 0)
                        {
                            <div class="comment__replies">
                                @{ await RenderThread(comment.Replies, depth + 1); }
                            </div>
                        }
                    </div>
                </div>
            }
        }

        <section class="comments-section" id="comments">
            <div class="comments-section__header">
                <h3>Yorumlar <span>@Model.CommentCount</span></h3>
            </div>

            @if (TempData["CommentError"] is string commentError)
            {
                <p class="comment-alert" role="alert">@commentError</p>
            }

            @if (isAuthenticated)
            {
                <form class="comment-form" method="post" action="~/makale/@Model.Slug/yorum" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="BlogId" value="@Model.Id">
                    <textarea name="Content" rows="3" maxlength="1000" placeholder="Düşüncelerini paylaş..." aria-label="Yorumun"></textarea>
                    <p class="comment-form__error" role="alert" hidden>Yorum boş olamaz.</p>
                    <div class="comment-form__actions">
                        <button type="submit" class="btn btn--primary">Yorum Yap</button>
                    </div>
                </form>

                <template id="reply-form-template">
                    <form class="comment-form comment-form--reply" method="post" action="~/makale/@Model.Slug/yorum" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="BlogId" value="@Model.Id">
                        <input type="hidden" name="ParentCommentId" value="">
                        <textarea name="Content" rows="2" maxlength="1000" placeholder="Cevabını yaz..." aria-label="Cevabın"></textarea>
                        <p class="comment-form__error" role="alert" hidden>Cevap boş olamaz.</p>
                        <div class="comment-form__actions">
                            <button type="button" class="btn btn--ghost comment-form__cancel">İptal</button>
                            <button type="submit" class="btn btn--primary">Gönder</button>
                        </div>
                    </form>
                </template>
            }
            else
            {
                <div class="locked-banner">
                    <div class="info">
                        <svg width="20px" height="20px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M12 14.5V16.5M7 10.0288C7.47142 10 8.05259 10 8.8 10H15.2C15.9474 10 16.5286 10 17 10.0288M7 10.0288C6.41168 10.0647 5.99429 10.1455 5.63803 10.327C5.07354 10.6146 4.6146 11.0735 4.32698 11.638C4 12.2798 4 13.1198 4 14.8V16.2C4 17.8802 4 18.7202 4.32698 19.362C4.6146 19.9265 5.07354 20.3854 5.63803 20.673C6.27976 21 7.11984 21 8.8 21H15.2C16.8802 21 17.7202 21 18.362 20.673C18.9265 20.3854 19.3854 19.9265 19.673 19.362C20 18.7202 20 17.8802 20 16.2V14.8C20 13.1198 20 12.2798 19.673 11.638C19.3854 11.0735 18.9265 10.6146 18.362 10.327C18.0057 10.1455 17.5883 10.0647 17 10.0288M7 10.0288V8C7 5.23858 9.23858 3 12 3C14.7614 3 17 5.23858 17 8V10.0288" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg>
                        <div>
                            <h4>Yorum yapabilmek için giriş yapmanız gerekmektedir.</h4>
                        </div>
                    </div>
                    <div class="actions">
                        <a href="@loginUrl" class="btn btn--primary">Giriş Yap</a>
                        <a href="~/uye-ol" class="btn btn--primary">Üye Ol</a>
                    </div>
                </div>
            }

            @if (Model.Comments.Count == 0)
            {
                <p class="comments-empty">@(isAuthenticated ? "Henüz yorum yok. İlk yorumu sen yaz." : "Henüz yorum yok.")</p>
            }
            else
            {
                <div class="comments-list">
                    @{ await RenderThread(Model.Comments, 0); }
                </div>
            }
        </section>
    </article>

    <aside class="sidebar sidebar--sticky">
        <div class="widget widget--author">
            <div class="widget-header">
                <span>Yazar Hakkında</span>
                <i></i>
            </div>
            <div class="author-info">
                <img src="@authorAvatar" alt="@Model.AuthorName">
                <div>
                    <h4>@Model.AuthorName</h4>
                    <p>@(string.IsNullOrWhiteSpace(Model.AuthorHeadline) ? "Yazar" : Model.AuthorHeadline)</p>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.AuthorBio))
            {
                <p class="bio">@Model.AuthorBio</p>
            }
            @if (authorLinks.Count > 0)
            {
                    
                <div class="author-actions">
                    <p>İletişim ve Sosyal Medya</p>
                    <div class="socials">
                        @foreach (var link in authorLinks)
                        {
                            <a href="@link.Url" target="_blank" rel="noopener noreferrer nofollow" title="@link.Title" aria-label="@link.Title">@link.Title <svg fill="#94a3b8" width="15px" height="15px" viewBox="-5.5 0 32 32" version="1.1" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <title>external</title> <path d="M15.656 8.5l-10.438 10.5 2.188 2.219 10.469-10.469 1.938 1.906c0.531 0.531 1 0.375 1-0.438v-5.656c0-0.5-0.438-0.969-0.969-0.969h-5.656c-0.813 0-1 0.469-0.469 1zM16.813 23.031v-7.094h2.375v7.906c0 1.406-1.156 2.563-2.563 2.563h-14.063c-1.406 0-2.563-1.156-2.563-2.563v-14.094c0-1.406 1.156-2.563 2.563-2.531h8.656v2.375h-7.844c-0.5 0-0.969 0.469-0.969 0.969v12.469c0 0.5 0.469 0.969 0.969 0.969h12.469c0.5 0 0.969-0.469 0.969-0.969z"></path> </g></svg></a>
                        }
                    </div>
                </div>
            }
        </div>


    </aside>
</div>
