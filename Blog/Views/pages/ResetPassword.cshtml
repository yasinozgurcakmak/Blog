@model DtoLayer.Dtos.UserDtos.ResetPasswordDto
@{
    ViewData["Title"] = "Yeni Şifre Belirle";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    var linkValid = ViewData["LinkValid"] as bool? ?? false;
    var generalErrors = ViewData.ModelState[string.Empty]?.Errors;
}

<a href="~/giris-yap" class="btn btn--ghost auth-page__back">
    &larr; Girişe Dön
</a>

<div class="auth-card">
    <div class="auth-card__header">
        <div class="icon">🔑</div>
        <h2>Yeni şifre belirle</h2>
        <p>@(linkValid ? "Hesabın için yeni bir şifre oluştur." : "Bu şifre sıfırlama linki kullanılamıyor.")</p>
    </div>

    @if (!linkValid)
    {
        <div class="auth-form">
            <div class="alert alert--error">
                <i>⚠</i>
                <div>
                    <strong>Link geçersiz veya süresi dolmuş</strong>
                    <span>Şifre sıfırlama linkleri 1 saat geçerlidir ve yalnızca bir kez kullanılabilir. Yeni bir link isteyebilirsin.</span>
                </div>
            </div>
            <a href="~/sifremi-unuttum" class="btn btn--primary btn--full">Yeni Link İste</a>
        </div>
    }
    else
    {
        <form class="auth-form" method="post" action="~/sifre-sifirla">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Token" />

            @if (generalErrors is { Count: > 0 })
            {
                <div class="alert alert--error">
                    <i>⚠</i>
                    <div>
                        <strong>Şifre güncellenemedi</strong>
                        @foreach (var error in generalErrors)
                        {
                            <span>@error.ErrorMessage</span>
                        }
                    </div>
                </div>
            }

            <div class="form-group">
                <div class="label-flex">
                    <label asp-for="Password">Yeni Şifre</label>
                    <span class="pwd-status" id="pwd-status"></span>
                </div>
                <div class="input-wrapper">
                    <input asp-for="Password" type="password" id="reg-password" placeholder="••••••••••••" autocomplete="new-password" required autofocus>
                    <button type="button" class="btn-toggle-pwd" aria-label="Şifreyi göster/gizle">👁</button>
                </div>
                <div class="strength-meter" id="strength-meter" data-level="0">
                    <div class="bars">
                        <div class="bar"></div>
                        <div class="bar"></div>
                        <div class="bar"></div>
                        <div class="bar"></div>
                    </div>
                    <div class="strength-text">
                        <span id="strength-hint">8+ karakter, büyük/küçük harf, rakam ve sembol</span>
                        <strong id="strength-percent"></strong>
                    </div>
                </div>
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div class="form-group">
                <div class="label-flex">
                    <label asp-for="ConfirmPassword">Yeni Şifre Tekrarı</label>
                    <span class="pwd-status" id="confirm-status"></span>
                </div>
                <div class="input-wrapper">
                    <input asp-for="ConfirmPassword" type="password" id="reg-password-confirm" placeholder="••••••••••••" autocomplete="new-password" required>
                    <button type="button" class="btn-toggle-pwd" aria-label="Şifreyi göster/gizle">👁</button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>

            <button type="submit" class="btn btn--primary btn--full">Şifremi Güncelle</button>
        </form>
    }
</div>
