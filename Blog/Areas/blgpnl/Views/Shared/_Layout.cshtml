<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href='~/admin/assets/js/fancybox/fancybox.css' />
    <link rel="stylesheet" href="~/admin/assets/css/style.css" />
</head>
<body>
    <main role="main">
        <nav>
            <ul>
                <li><a href="/blgpnl/kullanicilar" class="@(Context.Request.Path.StartsWithSegments("/blgpnl/kullanicilar") ? "active" : "")"> <span>Kullanıcılar</span></a></li>
                <li><a href="/blgpnl/cikis"> <span>Çıkış</span></a></li>
            </ul>
        </nav>

        @RenderBody()
    </main>
    <script src="~/admin/assets/js/fancybox/fancybox.umd.js"></script>
    <script src="~/admin/assets/js/functions.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
