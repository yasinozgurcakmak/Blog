@model BlogEditViewModel
@{
    ViewData["Title"] = "Blog Yazısını Düzenle";
    Layout = "~/Areas/blgpnl/Views/Shared/_Layout.cshtml";
    var hasThumbnail = !string.IsNullOrEmpty(Model.Dto.ExistingThumbnail);
    var tr = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");

    const int CommentPreviewLength = 100;

    int CountReplies(DtoLayer.Dtos.CommentDtos.CommentDto comment) => comment.Replies.Sum(r => 1 + CountReplies(r));

    string ShortenComment(string content)
    {
        var length = char.IsHighSurrogate(content[CommentPreviewLength - 1]) ? CommentPreviewLength - 1 : CommentPreviewLength;
        return content[..length].TrimEnd() + "...";
    }

    async Task RenderCommentRows(List<DtoLayer.Dtos.CommentDtos.CommentDto> comments, int depth)
    {
        foreach (var comment in comments)
        {
            var replyCount = CountReplies(comment);
            var confirmText = replyCount > 0
                ? $"Bu yorum ve altındaki {replyCount} cevap kalıcı olarak silinecek. Emin misiniz?"
                : "Bu yorum kalıcı olarak silinecek. Emin misiniz?";
            <tr>
                <td style="padding-left: @(12 + depth * 24)px;">
                    @if (depth > 0)
                    {
                        <span>↳</span>
                    }
                    @if (comment.IsDeleted)
                    {
                        <em style="color: #888;">Kullanıcı tarafından silindi</em>
                    }
                    else if (comment.Content.Length > CommentPreviewLength)
                    {
                        <span>@ShortenComment(comment.Content)</span>
                        <a href="#comment-full-@comment.Id" data-fancybox="comment-@comment.Id" style="color: #2196F3; white-space: nowrap;">Tamamını oku</a>
                        <div id="comment-full-@comment.Id" style="display:none; max-width: 640px;">
                            <p style="margin-bottom: 10px;"><strong>@comment.AuthorName</strong> · @comment.CreatedDate.ToString("dd MMMM yyyy HH:mm", tr)</p>
                            <p style="white-space: pre-line; line-height: 1.6;">@comment.Content</p>
                        </div>
                    }
                    else
                    {
                        <span style="white-space: pre-line;">@comment.Content</span>
                    }
                </td>
                <td>@comment.AuthorName</td>
                <td>@comment.CreatedDate.ToString("dd MMMM yyyy HH:mm", tr)</td>
                <td>@comment.LikeCount</td>
                <td>
                    <form method="post" action="~/blgpnl/yazilar/yorum-sil/@comment.Id" data-confirm="@confirmText">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-delete">Sil</button>
                    </form>
                </td>
            </tr>
            await RenderCommentRows(comment.Replies, depth + 1);
        }
    }
}

<section class="edit-section">
    <div class="edit-form-wrapper">
        <h1>Blog Yazısını Düzenle</h1>

        <form method="post" action="~/blgpnl/yazilar/duzenle/@Model.Dto.Slug" enctype="multipart/form-data" class="blog-form" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Dto.Id" />
            <input type="hidden" asp-for="Dto.ExistingThumbnail" />

            <div class="form-group requiredField">
                <label asp-for="Dto.Title">Başlık <span class="required-star">*</span></label>
                <input type="text" asp-for="Dto.Title" id="titleInput" placeholder="Blog başlığını giriniz..." />
                <span asp-validation-for="Dto.Title" class="validation-error-msg"></span>
            </div>

            <div class="form-group requiredField">
                <label asp-for="Dto.Slug">URL Bağlantısı (Slug) <span class="required-star">*</span></label>
                <input type="text" asp-for="Dto.Slug" id="slugInput" placeholder="blog-basligi-gibi" />
                <small class="form-hint">Başlık değiştirilirse otomatik güncellenebilir veya elle düzenleyebilirsiniz.</small>
                <span asp-validation-for="Dto.Slug" class="validation-error-msg"></span>
            </div>

            <div class="form-group requiredField">
                <label asp-for="Dto.Summary">Özet / Ön Yazı <span class="required-star">*</span></label>
                <textarea asp-for="Dto.Summary" rows="3" placeholder="Blog ile ilgili kısa özet yazınız..."></textarea>
                <span asp-validation-for="Dto.Summary" class="validation-error-msg"></span>
            </div>

            <div class="form-group requiredField">
                <label asp-for="Dto.CategoryId">Kategori <span class="required-star">*</span></label>
                <select asp-for="Dto.CategoryId" class="select2-select" asp-items="Model.Categories">
                    <option value="">-- Kategori Seçiniz --</option>
                </select>
                <span asp-validation-for="Dto.CategoryId" class="validation-error-msg"></span>
            </div>

            <div class="form-group requiredField">
                <label asp-for="Dto.Content">Blog İçeriği <span class="required-star">*</span></label>
                <textarea asp-for="Dto.Content" id="summernote"></textarea>
                <span asp-validation-for="Dto.Content" class="validation-error-msg"></span>
            </div>

            <div class="form-group">
                <label asp-for="Dto.MetaTitle">SEO Başlık (Meta Title)</label>
                <input type="text" asp-for="Dto.MetaTitle" placeholder="Arama motorlarında görünecek başlık..." />
                <span asp-validation-for="Dto.MetaTitle" class="validation-error-msg"></span>
            </div>

            <div class="form-group">
                <label asp-for="Dto.MetaDescription">SEO Açıklaması (Meta Description)</label>
                <textarea asp-for="Dto.MetaDescription" rows="3" placeholder="Arama motorlarında görünecek açıklama..."></textarea>
                <span asp-validation-for="Dto.MetaDescription" class="validation-error-msg"></span>
            </div>

            <div class="form-group requiredField">
                <label>Küçük Resim (Thumbnail) <span class="required-star">*</span> <small class="form-hint" style="display:inline; margin-left:6px; font-weight:normal;">(Görsel boyutları 300x300 px olmalıdır)</small></label>

                <div class="file-wrapper" onclick="this.querySelector('.file').click();" style="cursor: pointer;">
                    <input type="file" asp-for="Dto.NewThumbnailFile" class="file" accept="image/*" onclick="event.stopPropagation();" />
                    <svg width="50px" height="50px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M21 11V15.8C21 16.9201 21 17.4802 20.782 17.908C20.5903 18.2843 20.2843 18.5903 19.908 18.782C19.4802 19 18.9201 19 17.8 19H6.2C5.0799 19 4.51984 19 4.09202 18.782C3.71569 18.5903 3.40973 18.2843 3.21799 17.908C3 17.4802 3 16.9201 3 15.8V8.2C3 7.0799 3 6.51984 3.21799 6.09202C3.40973 5.71569 3.71569 5.40973 4.09202 5.21799C4.51984 5 5.0799 5 6.2 5H15M21 11L15 5M21 11H16.6C16.0399 11 15.7599 11 15.546 10.891C15.3578 10.7951 15.2049 10.6422 15.109 10.454C15 10.2401 15 9.96005 15 9.4V5" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg>
                    <span>Görsel Seçiniz</span>
                </div>

                <div id="imagePreviewWrapper" class="image-preview-wrapper" style="@(hasThumbnail ? "" : "display: none;")">
                    <div class="image-preview-card">
                        <div class="preview-header">
                            <span id="previewBadge" class="preview-badge">
                                <i class="fa-solid fa-image"></i> @(hasThumbnail ? "Mevcut Görsel" : "Görsel Ön Gösterimi")
                            </span>
                            <button type="button" id="btnRemoveImage" class="btn-remove-image" style="@(hasThumbnail ? "display: none;" : "")" title="Seçilen Görseli Kaldır">
                                <i class="fa-solid fa-trash-can"></i> Kaldır
                            </button>
                        </div>
                        <div class="preview-body">
                            <img id="imagePreview" src="@(hasThumbnail ? Model.Dto.ExistingThumbnail : "#")" data-original-src="@(hasThumbnail ? Model.Dto.ExistingThumbnail : "")" alt="Görsel Öngösterimi" />
                        </div>
                        <div class="preview-footer">
                            <span id="previewInfo" class="preview-info">@(hasThumbnail ? "Kayıtlı görsel kullanılıyor" : "")</span>
                        </div>
                    </div>
                </div>
                <span asp-validation-for="Dto.NewThumbnailFile" id="fileValidationError" class="validation-error-msg"></span>
            </div>

            <div class="form-group">
                <label asp-for="Dto.PublishDate">Yayınlanma Tarihi & Saati</label>
                <input type="datetime-local" asp-for="Dto.PublishDate" asp-format="{0:yyyy-MM-ddTHH:mm}" />
                <small class="form-hint">İleri bir tarih ve saat seçerseniz, yazı o vakit gelene kadar sitede görünmez (zamanlanır).</small>
            </div>

            <div class="form-group">
                <label asp-for="Dto.Status">Yayın Durumu</label>
                <select asp-for="Dto.Status">
                    <option value="true">Aktif / Yayında</option>
                    <option value="false">Taslak / Pasif</option>
                </select>
            </div>

            <div class="row">
                <button type="submit" class="btn btn-edit">Güncelle</button>
                <a href="~/blgpnl/yazilar" class="btn btn-delete">İptal</a>
            </div>
        </form>
    </div>

    <div class="edit-form-wrapper" id="yorumlar">
        <h1>Yorumlar (@Model.CommentCount)</h1>

        @if (Model.Comments.Count == 0)
        {
            <p>Bu yazıya henüz yorum yapılmamış.</p>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <td>Yorum</td>
                        <td>Kullanıcı</td>
                        <td>Tarih</td>
                        <td>Beğeni</td>
                        <td>Aksiyon</td>
                    </tr>
                </thead>
                <tbody>
                    @{ await RenderCommentRows(Model.Comments, 0); }
                </tbody>
            </table>
        }
    </div>
</section>
