
@model DtoLayer.Dtos.UserDtos.UserLoginDto
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Giriş Yap</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/admin/assets/css/style.css" />
</head>
<body>
    <section class="login">
        <div class="form-wrapper">
            <h1>Giriş Yap</h1>

            @* Hata mesajlarını göster *@
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <form method="post" action="/blgpnl/giris-yap">
                @Html.AntiForgeryToken()
                <input type="text" placeholder="Kullanıcı Adı veya E-posta" autocomplete="off" asp-for="UserName" />
                <span asp-validation-for="UserName" class="text-danger"></span>
                <input type="password" placeholder="Parola" autocomplete="off" asp-for="Password" />
                <span asp-validation-for="Password" class="text-danger"></span>
                <input type="submit" class="btn full" value="Giriş Yap">
            </form>
        </div>
    </section>
</body>
</html>
